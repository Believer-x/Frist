{
  "manifest_version": 3,
  "name": "字幕桥 · 视频双语翻译",
  "version": "1.1.0",
  "description": "采集当前标签页声音，通过本机 Whisper 识别并翻译，显示双语字幕；同时支持网页现有字幕。",
  "permissions": [
    "storage",
    "tabCapture",
    "offscreen",
    "activeTab"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "字幕桥",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116"
}
